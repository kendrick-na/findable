{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.x",
  "ignoreCommand": "node scripts/skip-ci.js",
  "functions": {
    "app/api/cron/auto-refresh-tracking/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/auto-refresh-tracking",
      "schedule": "0 17 * * *"
    }
  ]
}
