// ──────────────────────────────────────────────────
// 파트너 승인 (insider 접근권의 단일 진실)
// Clerk publicMetadata.plan="insider"는 이 테이블의 파생 캐시일 뿐.
// 실제 게이팅은 status=approved(=DB)를 최종 확인한다.
// ──────────────────────────────────────────────────

model PartnerApplication {
  id        String                   @id @default(uuid())
  userId    String                   @unique // Clerk user_id (신청자, 1인 1건)
  status    PartnerApplicationStatus @default(pending)
  reason    String? // 신청 사유(선택)
  decidedBy String? // 처리한 admin Clerk user_id
  decidedAt DateTime?
  note      String? // 거절 사유 등 관리자 메모
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  @@index([status])
}

