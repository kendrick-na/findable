// Findable v1.0 데이터 모델
// PRD §10 기준. RLS·Drizzle 마이그레이션은 v2.0 (D-006)
// next-forge 기본 Prisma 7.x + Neon Postgres + @prisma/adapter-neon

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

// ──────────────────────────────────────────────────
// 조직 + 사용자 (Clerk 연동)
// ──────────────────────────────────────────────────

model Organization {
  id                String           @id @default(uuid())
  name              String
  ownerId           String // Clerk user_id
  plan              Plan             @default(free)
  planExpiresAt     DateTime?
  trialEndsAt       DateTime?
  billingStatus     BillingStatus    @default(trialing)
  billingCustomerId String? // PortOne billingKey(정기결제) · Toss billingKey · PayPal payerId
  billingProvider   BillingProvider?
  // 다음 예약 결제를 한 건만 유지한다. 웹훅 재전송 때 이 ID를 기준으로 중복 청구를 막는다.
  billingLastPaymentId String?
  billingNextPaymentId String?
  billingNextPaymentAt DateTime?
  // 회원가입 이후 브랜드 설정 진행 상태. 측정 성공 여부와 온보딩 완료 여부를 분리한다.
  onboardingStep        Int       @default(1)
  onboardingCompletedAt DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  users     User[]
  brands    Brand[]
  reports   Report[]
  auditJobs AuditJob[]
  siteReadinessRuns SiteReadinessRun[]
  searchPerformanceConnections SearchPerformanceConnection[]
  mailboxConnections MailboxConnection[]
  outreachDrafts OutreachDraft[]
  indexNowConfigurations IndexNowConfiguration[]
  consultationNotes      ConsultationNote[]

  @@index([ownerId])
}

model User {
  id             String        @id // Clerk user_id
  email          String        @unique
  name           String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())

  @@index([organizationId])
}

// ──────────────────────────────────────────────────
// 운영 컨설팅 기록
// ──────────────────────────────────────────────────
// 고객사별 분석 결과와 분리된 운영자 메모. 조직 단위로만 연결해 한 고객사의
// 기록이 다른 고객사 화면에 섞이지 않게 한다.
model ConsultationNote {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  body           String       @db.Text
  nextCheckAt    DateTime?
  createdBy      String
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

// ──────────────────────────────────────────────────
// 브랜드 + 프롬프트
// ──────────────────────────────────────────────────

model Brand {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  domain         String
  industry       Industry?
  language       BrandLanguage @default(both)
  // 타깃 시장(2026-08-02 세션M). null = 자동 추정(도메인·업종·측정언어).
  // 점수의 **분모**를 정한다 — 국내 전용 고객은 글로벌 엔진이 빠져 "글로벌 0점"이
  // 산출될 수 없다(감점이 아니라 비해당). 📕타깃시장선언_SEO선례_2026-08-02.md
  marketScope    MarketScope?
  competitors    Json          @default("[]") // [{ name, domain }]
  entityVariants Json          @default("[]") // ["아모레", "Amorepacific", "아모레퍼시픽"] — Korean Entity Grounding
  // 고객이 직접 넣은 공식 회사 정보(2026-10-06). 측정 판정의 공식 근거로만 쓰고 화면·리포트에
  // 공개하지 않는다. 홈페이지 푸터에서 찾은 값보다 우선한다. null = 입력 안 함.
  legalName      String?
  businessNumber String? // "000-00-00000" 으로 정규화해 저장
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  prompts           Prompt[]
  trackings         Tracking[]
  reports           Report[]
  auditJobs         AuditJob[]
  siteReadinessRuns SiteReadinessRun[]
  actionCompletions ActionCompletion[]
  annotations       Annotation[]
  publisher         Publisher?
  searchPerformanceConnections SearchPerformanceConnection[]
  indexNowConfiguration IndexNowConfiguration?

  @@index([organizationId])
  @@index([domain])
}

// ──────────────────────────────────────────────────
// SEO/GEO 퍼블리싱 플랫폼
//   진단 액션 → 초안 → 퍼블리셔 승인 → 품질 검사 → 공개 발행을 한 DB에서 추적한다.
//   고객사 소유권은 Publisher.brand → Brand.organizationId 경로가 단일 진실이다.
// ──────────────────────────────────────────────────

model Publisher {
  id                            String             @id @default(uuid())
  kind                          PublisherKind
  slug                          String             @unique
  name                          String
  description                   String?            @db.Text
  websiteUrl                    String?
  logoUrl                       String?
  customDomain                  String?            @unique
  customDomainStatus            CustomDomainStatus @default(unconfigured)
  customDomainVerificationToken String?
  customDomainVerification      Json?
  customDomainUpdatedAt         DateTime?
  newsletterEnabled             Boolean            @default(true)

  // brand 퍼블리셔만 값이 있다. Findable 공식 퍼블리셔는 null이다.
  brandId String? @unique
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  verifiedAt  DateTime?
  suspendedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  contents                Content[]
  newsletterSubscriptions NewsletterSubscription[]

  @@index([kind])
}

model Content {
  id          String    @id @default(uuid())
  publisherId String
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  // GeoAction은 계산값이라 FK가 아니다. ActionCompletion과 같은 kind+target 축을 보존한다.
  sourceActionKind   String?
  sourceActionTarget String?
  sourceMeasuredAt   DateTime?

  locale       String
  slug         String
  title        String
  bodyMarkdown String  @db.Text
  excerpt      String? @db.Text

  // 공개 인사이트의 편집 메타데이터. 분류는 자유 문자열이 아니라 앱에서 정한
  // research·guide·case_study·analysis 네 값만 저장한다.
  contentType    String    @default("analysis")
  series         String?
  tags           String[]  @default([])
  coverImageUrl  String?
  coverImageAlt  String?
  seoTitle       String?
  seoDescription String?   @db.Text
  featuredAt     DateTime?
  scheduledAt    DateTime?
  sendNewsletter Boolean   @default(false)

  status      ContentStatus @default(draft)
  noindex     Boolean       @default(true)
  publishedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  revisions          ContentRevision[]
  reviewEvents       ContentReviewEvent[]
  qualityChecks      ContentQualityCheck[]
  publicationJobs    PublicationJob[]
  newsletterCampaign NewsletterCampaign?

  @@unique([publisherId, locale, slug])
  @@index([publisherId, status])
  @@index([status, publishedAt])
  @@index([status, scheduledAt])
  @@index([status, contentType, publishedAt])
}

model NewsletterSubscription {
  id                    String                       @id @default(uuid())
  publisherId           String
  publisher             Publisher                    @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  email                 String
  locale                String                       @default("ko")
  status                NewsletterSubscriptionStatus @default(pending)
  confirmationTokenHash String?                      @unique
  unsubscribeTokenHash  String                       @unique
  confirmedAt           DateTime?
  unsubscribedAt        DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  deliveries NewsletterDelivery[]

  @@unique([publisherId, email])
  @@index([publisherId, status])
}

model NewsletterCampaign {
  id          String                   @id @default(uuid())
  contentId   String                   @unique
  content     Content                  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  status      NewsletterCampaignStatus @default(queued)
  startedAt   DateTime?
  completedAt DateTime?
  lastError   String?                  @db.Text
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  deliveries NewsletterDelivery[]

  @@index([status, createdAt])
}

model NewsletterDelivery {
  id             String                   @id @default(uuid())
  campaignId     String
  campaign       NewsletterCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   NewsletterSubscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  status         NewsletterDeliveryStatus @default(queued)
  attempts       Int                      @default(0)
  providerId     String?
  lastError      String?                  @db.Text
  sentAt         DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([campaignId, subscriptionId])
  @@index([status, createdAt])
}

model ContentRevision {
  id        String  @id @default(uuid())
  contentId String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  version   Int

  title        String
  bodyMarkdown String  @db.Text
  excerpt      String? @db.Text

  // 생성 당시의 측정 근거를 불변 스냅샷으로 남긴다.
  sourceEvidence   Json?
  sourceMetrics    Json?
  generationPrompt String?  @db.Text
  model            String?
  createdBy        String?
  createdAt        DateTime @default(now())

  @@unique([contentId, version])
  @@index([contentId, createdAt])
}

model ContentReviewEvent {
  id        String                 @id @default(uuid())
  contentId String
  content   Content                @relation(fields: [contentId], references: [id], onDelete: Cascade)
  type      ContentReviewEventType
  actorId   String?
  note      String?                @db.Text
  createdAt DateTime               @default(now())

  @@index([contentId, createdAt])
}

model ContentQualityCheck {
  id        String               @id @default(uuid())
  contentId String
  content   Content              @relation(fields: [contentId], references: [id], onDelete: Cascade)
  status    ContentQualityStatus
  checks    Json
  summary   String?              @db.Text
  createdAt DateTime             @default(now())

  @@index([contentId, createdAt])
}

model PublicationJob {
  id          String               @id @default(uuid())
  contentId   String
  content     Content              @relation(fields: [contentId], references: [id], onDelete: Cascade)
  status      PublicationJobStatus @default(queued)
  attempts    Int                  @default(0)
  lastError   String?              @db.Text
  scheduledAt DateTime             @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([status, scheduledAt])
  @@index([contentId, createdAt])
}

model Prompt {
  id              String          @id @default(uuid())
  brandId         String
  brand           Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  text            String
  language        PromptLanguage
  category        PromptCategory?
  isAutoGenerated Boolean         @default(false)
  createdAt       DateTime        @default(now())

  trackings Tracking[]

  // D3(2026-07-29, 20번 설계): 같은 브랜드에 동일 프롬프트 텍스트 중복 생성 방지.
  //   audit 재실행 시 prompt.upsert(where: brandId_text)로 promptId 안정화 → 시계열 선 분열 방지.
  //   ⚠️ relationMode="prisma"라도 @@unique는 실제 DB 유니크 인덱스로 생성됨.
  //   마이그레이션 전 기존 (brandId,text) 중복 없음 확인 필수(Prompt 현재 빈 테이블이라 안전).
  @@unique([brandId, text])
  @@index([brandId])
}

// ──────────────────────────────────────────────────
// 엔진 (시드 데이터, 7개 + α)
// ──────────────────────────────────────────────────

model Engine {
  id       String         @id // chatgpt, claude, perplexity, gemini, hyperclova, naver, daum
  name     String
  provider EngineProvider
  language EngineLanguage
  isActive Boolean        @default(true)
  ordering Int            @default(0)

  trackings Tracking[]
}

// ──────────────────────────────────────────────────
// 추적 결과 (모든 엔진 호출의 raw + 분석)
// ──────────────────────────────────────────────────

model Tracking {
  id              String     @id @default(uuid())
  brandId         String
  brand           Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  promptId        String
  prompt          Prompt     @relation(fields: [promptId], references: [id], onDelete: Cascade)
  engineId        String
  engine          Engine     @relation(fields: [engineId], references: [id])
  rawResponse     String?    @db.Text
  brandMentioned  Boolean    @default(false)
  mentionPosition Int? // 1, 2, 3, ...
  // 순위가 나온 번호 목록의 총 항목 수(분모). "N개 중 mentionPosition 번째".
  // 세션N-10(2026-08-07) 신설 — 순위 숫자만으로는 "2개 중 1위"와 "50개 중 1위"가
  // 구분되지 않아 competition 점수(10점)가 둘을 똑같이 매기고 있었다.
  // ⚠️ 소급 불가: 도입 전 행은 null(화면·채점 양쪽에 null 폴백 있음).
  mentionListSize Int?
  sentiment       Sentiment?
  citedSources    Json       @default("[]") // [{ url, domain, title? }]
  shareOfVoice    Float? // 0.0 ~ 1.0
  errorMessage    String? // 호출 실패 시
  trackedAt       DateTime   @default(now())

  // ── 원가 계기 (세션N-47 · 2026-08-19) ──────────────────────────────
  // 🔴 **왜 신설했나**: 👤 가 *"그라운딩을 켜면 비용이 얼마나 오르나"* 를 물었는데
  //   **답할 방법이 없었다**. `packages/ai/lib/engines/cost.ts` 는 이미 있었으나
  //   **프로덕션 호출이 0곳**이고 토큰 수를 **어디에도 안 남기고** 있었다
  //   (📕 N-46 *"함수는 있는데 안 쓰고 있다"* 와 같은 유형).
  //   → 측정 1건 원가조차 모르는 상태였다. 요금제 설계의 분모가 비어 있던 셈이다.
  //
  // ⚠️ **소급 불가**: 도입 전 행은 전부 null 이다. 집계는 null 을 **0 으로 세지 말고**
  //   「미측정」으로 갈라야 한다 — 📕 이 저장소 최다 사고 *"못 잰 것을 0이라 부르기"*.
  inputTokens  Int?
  outputTokens Int?
  /**
   * 이 호출 1회 원가(KRW). `costOf()` 산출값 — 단가는 추정이라 청구서로 보정한다.
   */
  costKrw      Float?
  /**
   * 과금 방식: token / browser / free / unknown. null = 원가 미측정 회차.
   */
  costBasis    String?
  // New audit dual-writes use an immutable per-run row identity. Legacy rows
  // remain NULL and are intentionally excluded from the unique index.
  trackingRowKey String?

  @@index([brandId])
  @@index([promptId])
  @@index([engineId])
  @@index([brandId, trackedAt])
  @@unique([trackingRowKey], map: "Tracking_trackingRowKey_key")
}

// ──────────────────────────────────────────────────
// 리포트 (Audit · Weekly · Monthly · Custom)
// ──────────────────────────────────────────────────

// ──────────────────────────────────────────────────
// 액션 실행 기록 (2026-07-31 세션K-2) — "루프 닫기"
//   액션은 매 측정마다 재생성되므로(휘발성), **완료 표시만** 영속화한다.
//   key = kind + 대상 식별자(프롬프트 원문·도메인 등)의 안정적 해시가 아니라 사람이 읽는 조합.
//   → 다음 측정에서 같은 액션이 다시 나오면 "완료 처리됨 + 그때 대비 점수 변화"를 보여준다.
//   ⚠️ additive only. 기존 테이블·쿼리에 영향 0.
// ──────────────────────────────────────────────────
model ActionCompletion {
  id      String @id @default(uuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  /**
   * 액션 종류(rank_strategy·prompt_gap·source_portfolio·content_fix·avoid).
   */
  kind   String
  /**
   * 같은 종류 안에서 대상을 구분하는 키(프롬프트 원문·도메인 등). 없으면 빈 문자열.
   */
  target String @default("")

  /**
   * 완료 시점의 스냅샷 — before/after 대조용. 측정이 갱신돼도 이 값은 고정.
   */
  sovAtCompletion         Float?
  recognitionAtCompletion Float?

  /**
   * 2026-09-28 근거 등급 액션 — 완료 시점의 오인율·정확 설명률(0~1) 스냅샷.
   * 분모 = 판정까지 끝난 답변 수(`summarizeVerdicts`). 구 기록은 null.
   */
  misidentificationRateAtCompletion Float?
  accurateRateAtCompletion          Float?

  /**
   * 조치를 시작한 시각(선택). before 기준점 — 조치 도중 측정을 before 로 쓰지 않는다.
   */
  startedAt DateTime?

  completedAt DateTime @default(now())
  completedBy String? // Clerk user_id

  @@unique([brandId, kind, target])
  @@index([brandId])
}

/// 추세 차트 수동 주석 (2026-08-07 세션N-8, 감사 D2).
///
/// 왜 자동 핀이 아니라 수동인가: 리서치 원본 02_SEO_SaaS §Sistrix 는 자동 핀(가시성
/// ≥15.5%p 변동 시)을 적었지만, **우리 데이터엔 그 변동이 없다** — 실측 연속 측정 델타
/// [0, 0, 0, 0, +97]이고 +97은 측정 실패→복구 아티팩트다. 임계값을 뭘로 잡아도 핀은
/// "측정 실패 지점"에만 꽂힌다. 그건 이벤트가 아니라 오류 표시다.
/// 그리고 같은 리서치가 GSC 수동 주석(*"차트 날짜 우클릭으로 메모 고정"*)을
/// **"무료인데 명료함의 기준점"** 으로 꼽았고, Sistrix 자신도 초록 핀 = 사용자 주석을
/// 함께 준다. GEO에서 변화의 원인(보도자료·콘텐츠 발행·경쟁사 캠페인)은 **고객만 안다**
/// — 시스템이 추측할 수 없는 정보라 수동이 먼저다.
///
/// 🔴 org 격리: `Tracking`·`ActionCompletion` 과 같은 계약 — org 컬럼 없이 **brand 경유**로만
/// 조직에 매인다. 반드시 `scoped*` 헬퍼로 접근할 것(lib/db/scoped.ts 상단 경고).
model Annotation {
  id      String @id @default(uuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  /// 주석이 가리키는 시점. 추세 차트의 X축 위치를 정한다(측정 시각과 정확히 같을 필요 없음).
  occurredAt DateTime
  /// 무슨 일이 있었나. 예: "보도자료 배포", "브랜드 페이지 개편".
  label      String

  createdAt DateTime @default(now())
  createdBy String? // Clerk user_id

  @@index([brandId, occurredAt])
}

model Report {
  id             String        @id @default(uuid())
  brandId        String?
  brand          Brand?        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           ReportType
  pdfUrl         String?
  data           Json? // SoV·Sentiment·시계열·경쟁사 비교 등
  generatedAt    DateTime      @default(now())
  /// 고객 웹 리포트(`/r/<accessToken>`) 공유 링크 토큰 (2026-09-28).
  /// id(uuid)를 URL 에 그대로 쓰지 않는 이유: 링크를 **폐기·재발급**할 수 있어야 한다
  /// (null 로 지우면 그 링크만 즉시 404). 256비트 base64url — 추측 불가.
  accessToken    String?       @unique
  views          ReportView[]

  @@index([brandId])
  @@index([organizationId])
}

/// 고객 웹 리포트 열람 기록 (2026-09-28). **개인정보를 담지 않는다** —
/// IP·쿠키·Clerk id 없음. user-agent 는 원문이 아니라 SHA-256 앞 16자만(같은 기기 반복 열람 구분용).
/// Report.data 에 덧붙이지 않는 이유: data 는 사람이 판별을 확정한 **동결 스냅숏**이라
/// 열람 때마다 고쳐 쓰면 동시 쓰기에서 판별 데이터가 덮일 수 있다.
model ReportView {
  id       String   @id @default(uuid())
  reportId String
  report   Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())
  uaHash   String?

  @@index([reportId, viewedAt])
}

// ──────────────────────────────────────────────────
// 무료 Audit 잡 (PLG 진입점, 비로그인)
// ──────────────────────────────────────────────────

model AuditJob {
  id       String        @id @default(uuid())
  email    String
  domain   String
  industry Industry?
  language BrandLanguage @default(both)
  status   AuditStatus   @default(queued)
  pdfUrl   String?
  result   Json? // SoV · 경쟁사 비교 · Top 3 추천 (휴리스틱 빠른 모드)
  postprocessing Json? // core result와 Tracking/PDF/briefing 완료 상태를 분리한다.
  checkpoint Json? // 미완료 질문 응답. completed result와 분리해 공개 리포트에 노출하지 않는다.
  leaseToken String? // 실행별 fencing token. 늦은 writer가 재개된 Job을 덮어쓰지 못하게 한다.
  leaseUntil DateTime?
  attemptStartedAt DateTime? // 재개 시 createdAt 대신 stale 판정 기준

  // 강화 모드 (4 에이전트 분석) — 옵션
  crewStatus      CrewStatus @default(not_requested)
  crewResult      Json? // 민지·Alex·수진·준호 4 에이전트 리포트
  crewStartedAt   DateTime?
  crewCompletedAt DateTime?

  errorMessage String?
  ipAddress    String? // 어뷰즈 방지 (rate limit)
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  // P5 8-b (2026-07-30, 20번 2단계 D8): org 트리거 job 을 그래프에 연결하는 nullable FK.
  // 반드시 nullable — 무료(비로그인) audit 은 영구적으로 org 없음. SetNull = 감사이력 보존
  // (⚠️ relationMode="prisma" 라 SetNull 은 Prisma delete 경유에서만 동작, raw SQL 삭제 금지).
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  brandId        String?
  brand          Brand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([organizationId])
  @@index([brandId])
}

// ──────────────────────────────────────────────────
// 저장 질문 시도 원장 (W1 PromptAttempt, migration 20261005_prompt_attempt_ledger)
//   성공 Tracking 과 분리된 "어떤 Job 이 어떤 저장 질문을 골랐고 결과가 어땠나" 기록.
//   실패한 질문이 매 실행 다시 뽑혀 다른 저장 질문을 굶기는 문제(failure starvation)를
//   selectionSeq 순환 + 연속 실패 cooldown/needs-attention 으로 막는다.
//   ⚠️ PROMPT_ATTEMPT_LEDGER_ENABLED="true" 일 때만 읽고 쓴다(기본 off).
//   ⚠️ 의도적으로 Brand/Prompt/AuditJob 과 Prisma relation 을 두지 않는다:
//     relationMode="prisma" 에서 relation 을 걸면 Prompt/Brand 삭제 때 Prisma 가 이
//     테이블을 연쇄 조회·삭제한다 → migration 적용 전 배포에서 기존 삭제 경로가 깨진다.
//     고아 행은 선택 로직이 현재 저장 질문과 교집합만 보므로 무해하다.
// ──────────────────────────────────────────────────

enum PromptAttemptOutcome {
  completed
  failed
  unverified
  abandoned
}

model PromptAttempt {
  id                String                @id @default(uuid())
  auditJobId        String
  brandId           String
  promptId          String
  // 브랜드 안에서 단조 증가하는 내구 선택 순서. 순환 기준(성공 Tracking 시각 아님).
  selectionSeq      Int
  planIndex         Int
  planSize          Int
  // dispatch 횟수. 만료 lease 인계 후 재호출하면 +1.
  attemptNo         Int                   @default(1)
  // 이 행을 갱신할 수 있는 현재 fence(AuditJob.leaseToken 과 같아야 한다).
  leaseToken        String
  selectedAt        DateTime
  startedAt         DateTime?
  startedLeaseToken String?
  finishedAt        DateTime?
  outcome           PromptAttemptOutcome?

  @@unique([auditJobId, promptId])
  @@unique([auditJobId, planIndex])
  @@unique([brandId, selectionSeq])
  @@index([brandId, promptId, selectionSeq])
}

// 연속 실패 수동 초기화 표식 — 이 시각 이전에 선택된 시도는 연속 실패 계산에서 제외.
model PromptAttemptReset {
  id       String   @id @default(uuid())
  brandId  String
  promptId String
  reason   String?
  resetAt  DateTime @default(now())

  @@index([brandId, promptId])
}

// ──────────────────────────────────────────────────
// 사이트 SEO/GEO 기술 준비도 측정
//   온보딩 완료·도메인 변경·수동 재측정이 모두 같은 실행 이력에 쌓인다.
//   report는 당시 관측 근거의 스냅샷이라 소급 변경하지 않는다.
// ──────────────────────────────────────────────────

model SiteReadinessRun {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brandId        String
  brand          Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  targetUrl      String
  finalUrl       String?
  status         String       @default("queued") // queued | processing | completed | failed
  trigger        String       @default("manual") // onboarding | brand_create | domain_change | manual
  report         Json?
  errorCode      String?
  createdAt      DateTime     @default(now())
  startedAt      DateTime?
  completedAt    DateTime?

  @@index([organizationId, createdAt])
  @@index([brandId, createdAt])
  @@index([status])
}

// Google Search Console·GA4의 고객 승인 연결과 일별 실측 데이터.
// Findable AI 응답 측정과 섞지 않으며, provider별 상태와 출처를 그대로 노출한다.
model SearchPerformanceConnection {
  id                    String       @id @default(uuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brandId               String
  brand                  Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  provider              String       // google_search_console | google_analytics_4 | naver_search_advisor_csv
  propertyId            String?
  propertyName          String?
  status                String       @default("pending_property") // pending_property | connected | syncing | error
  encryptedRefreshToken String?      @db.Text // CSV imports have no OAuth token.
  scopes                String[]     @default([])
  createdBy             String
  tokenUpdatedAt        DateTime     @default(now())
  lastSyncedAt          DateTime?
  lastErrorCode         String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  daily SearchPerformanceDaily[]

  @@unique([brandId, provider])
  @@index([organizationId, updatedAt])
  @@index([status])
}

// 운영자 영업 초안 전용(2026-09-29). 발송 기능은 없다 — Gmail 초안함에 넣는 것까지만.
// 조직과 운영자 userId 를 함께 묶는다.
model MailboxConnection {
  id                    String       @id @default(uuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId                String
  provider              String       // google_workspace
  email                 String
  encryptedRefreshToken String       @db.Text
  scopes                String[]     @default([])
  status                String       @default("connected")
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  drafts                OutreachDraft[]

  @@unique([organizationId, userId, provider])
  @@index([organizationId, updatedAt])
}

model OutreachDraft {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  connectionId   String
  connection     MailboxConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  idempotencyKey String
  /// 영업 스냅샷의 리드 id(공식 도메인). 직접 작성한 초안이면 null.
  leadId         String?
  /// 초안 From 에 넣은 회사 주소 별칭(예: contact@findable.co.kr). 개인 주소 발송 사고 방지 기록.
  sender         String
  recipient      String
  subject        String
  bodyHash       String
  remoteDraftId  String?
  status         String            @default("pending") // pending | created | failed
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, userId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([organizationId, leadId])
  @@index([connectionId])
}

model SearchPerformanceDaily {
  id                String                      @id @default(uuid())
  connectionId      String
  connection        SearchPerformanceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  date              DateTime
  clicks            Int?
  impressions       Int?
  ctr               Float?
  averagePosition   Float?
  sessions          Int?
  engagedSessions   Int?
  keyEvents         Float?
  totalRevenue      Float?
  dataFinal         Boolean                     @default(true)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@unique([connectionId, date])
  @@index([connectionId, date])
}

// 고객 도메인의 IndexNow 키 확인과 실제 제출 근거.
// 키는 도메인 루트에서 공개되는 소유권 확인 값이며 비밀 자격증명이 아니다.
model IndexNowConfiguration {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brandId            String       @unique
  brand              Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  host               String
  key                String
  status             String       @default("configured") // configured | error
  keyVerifiedAt      DateTime?
  lastSubmittedAt    DateTime?
  lastSubmittedCount Int?
  lastHttpStatus     Int?
  lastErrorCode      String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([organizationId, updatedAt])
  @@index([status])
}

