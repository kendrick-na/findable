// ──────────────────────────────────────────────────
// 초대 코드 — 프로그램 참가 기업에게 기간제 권한 부여 (세션N-42)
//
// 🔴 결제와 **다른 축**이다. 코드는 `Organization.plan` 을 올릴 뿐이고
//   `packages/payments` 를 건드리지 않는다(카카오페이 심사 중 상품 구성 유지).
// ⭐ 만료는 `Organization.planExpiresAt` 이 담당한다 — 필드는 **이미 있었다**(미사용).
//   크론(auto-refresh-tracking)이 매일 돌며 지난 org 를 free 로 강하시킨다.
// ──────────────────────────────────────────────────

model InviteCode {
  id             String    @id @default(uuid())
  /// 사람이 손으로 옮겨 적는다(메일·PDF) → 저장·조회 모두 **대문자로 정규화**한다.
  code           String    @unique
  /// 무엇을 위한 코드인지(운영자 식별용). 예: "KAIST 오버엣지 2026".
  label          String
  /// 부여할 플랜. growth 면 매일 자동측정·질문 150개·경쟁사 비교가 열린다.
  grantPlan      Plan      @default(growth)
  /// 부여 기간(일). 30 이면 사용 시점부터 30일.
  grantDays      Int       @default(30)
  /// 코드 자체의 유효기한(배포 기간). null = 무기한.
  validUntil     DateTime?
  /// 총 사용 가능 횟수. null = 무제한.
  maxRedemptions Int?
  redeemedCount  Int       @default(0)
  createdAt      DateTime  @default(now())

  redemptions InviteRedemption[]

  @@index([code])
}

model InviteRedemption {
  id             String     @id @default(uuid())
  inviteCodeId   String
  inviteCode     InviteCode @relation(fields: [inviteCodeId], references: [id], onDelete: Cascade)
  /// 어느 조직이 썼는지. 같은 조직의 **재사용을 막는** 키다(기간 무한연장 방지).
  organizationId String
  /// 누가 눌렀는지(운영 추적용).
  userId         String
  redeemedAt     DateTime   @default(now())

  @@unique([inviteCodeId, organizationId])
  @@index([organizationId])
}
